{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_key"],
  "properties": {
    "api_key": {
      "type": "string",
      "title": "OpenRouter API key",
      "description": "Created at https://openrouter.ai/keys. Spends that key's credit.",
      "minLength": 20,
      "pattern": "^sk-or-[A-Za-z0-9._-]{10,}$",
      "writeOnly": true
    }
  }
}
