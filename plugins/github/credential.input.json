{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "app_id",
    "private_key",
    "webhook_secret"
  ],
  "properties": {
    "app_id": {
      "type": "string",
      "title": "GitHub App ID",
      "pattern": "^[1-9][0-9]*$"
    },
    "private_key": {
      "type": "string",
      "title": "Private key PEM file",
      "writeOnly": true,
      "x-input-file": true,
      "minLength": 1
    },
    "webhook_secret": {
      "type": "string",
      "title": "Webhook secret",
      "writeOnly": true,
      "minLength": 1
    }
  }
}
