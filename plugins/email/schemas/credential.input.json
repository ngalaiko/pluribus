{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["username", "password"],
  "properties": {
    "username": {
      "type": "string",
      "title": "Mail username",
      "minLength": 1,
      "maxLength": 320,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "password": {
      "type": "string",
      "title": "App-specific password",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001f]+$",
      "writeOnly": true
    }
  }
}
