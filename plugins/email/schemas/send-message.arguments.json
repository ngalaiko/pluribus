  "required": ["to", "text"],
  "properties": {
    "to": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "minLength": 3, "maxLength": 320 }
    },
    "cc": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 3, "maxLength": 320 }
    },
    "subject": {
      "type": "string",
      "maxLength": 998
    },
    "text": {
