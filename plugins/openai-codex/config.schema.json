{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "credentials"
  ],
  "properties": {
    "models": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reasoning_effort": {
      "type": "string",
      "minLength": 1,
      "description": "Default reasoning effort, such as medium. Request provider_options.reasoning_effort overrides this value."
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 300000
    },
    "credentials": {
      "type": "object",
      "required": [
        "subscription"
      ],
      "properties": {
        "subscription": {
          "type": "string",
          "minLength": 1,
          "description": "Handle of the enrolled Codex token pair."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
