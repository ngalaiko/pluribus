{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["credential"],
  "properties": {
    "credential": {
      "type": "string",
      "minLength": 1,
      "description": "Host-owned OAuth credential handle."
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 300000
    }
  },
  "additionalProperties": false
}
