{
  "provider": "openai-codex",
  "start": {
    "method": "POST",
    "url": "https://auth.openai.com/api/accounts/deviceauth/usercode",
    "body": {
      "encoding": "json",
      "fields": [
        {
          "name": "client_id",
          "value": {
            "parts": [
              {
                "literal": "app_EMoamEEZ73f0CkXaXp7hrann"
              }
            ]
          }
        }
      ]
    }
  },
  "prompt": {
    "verificationUri": {
      "parts": [
        {
          "literal": "https://auth.openai.com/codex/device"
        }
      ]
    },
    "userCode": {
      "parts": [
        {
          "response": {
            "step": "start",
            "pointer": "/user_code"
          }
        }
      ]
    },
    "intervalSeconds": {
      "step": "start",
      "pointer": "/interval",
      "default": 5
    },
    "expiresInSeconds": {
      "default": 900
    }
  },
  "poll": {
    "request": {
      "method": "POST",
      "url": "https://auth.openai.com/api/accounts/deviceauth/token",
      "body": {
        "encoding": "json",
        "fields": [
          {
            "name": "device_auth_id",
            "value": {
              "parts": [
                {
                  "response": {
                    "step": "start",
                    "pointer": "/device_auth_id"
                  }
                }
              ]
            }
          },
          {
            "name": "user_code",
            "value": {
              "parts": [
                {
                  "response": {
                    "step": "start",
                    "pointer": "/user_code"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "pendingStatuses": [
      403,
      404
    ],
    "errorPointer": "/error",
    "pendingErrors": [
      "deviceauth_authorization_pending"
    ],
    "slowDownErrors": [
      "slow_down"
    ],
    "deniedErrors": [
      "access_denied"
    ],
    "expiredErrors": [
      "expired_token"
    ]
  },
  "exchange": {
    "method": "POST",
    "url": "https://auth.openai.com/oauth/token",
    "body": {
      "encoding": "form",
      "fields": [
        {
          "name": "grant_type",
          "value": {
            "parts": [
              {
                "literal": "authorization_code"
              }
            ]
          }
        },
        {
          "name": "client_id",
          "value": {
            "parts": [
              {
                "literal": "app_EMoamEEZ73f0CkXaXp7hrann"
              }
            ]
          }
        },
        {
          "name": "code",
          "value": {
            "parts": [
              {
                "response": {
                  "step": "poll",
                  "pointer": "/authorization_code"
                }
              }
            ]
          }
        },
        {
          "name": "code_verifier",
          "value": {
            "parts": [
              {
                "response": {
                  "step": "poll",
                  "pointer": "/code_verifier"
                }
              }
            ]
          }
        },
        {
          "name": "redirect_uri",
          "value": {
            "parts": [
              {
                "literal": "https://auth.openai.com/deviceauth/callback"
              }
            ]
          }
        }
      ]
    }
  },
  "token": {
    "accessTokenPointer": "/access_token",
    "refreshTokenPointer": "/refresh_token",
    "expiresInPointer": "/expires_in"
  },
  "refresh": {
    "request": {
      "method": "POST",
      "url": "https://auth.openai.com/oauth/token",
      "body": {
        "encoding": "form",
        "fields": [
          {
            "name": "grant_type",
            "value": {
              "parts": [
                {
                  "literal": "refresh_token"
                }
              ]
            }
          },
          {
            "name": "client_id",
            "value": {
              "parts": [
                {
                  "literal": "app_EMoamEEZ73f0CkXaXp7hrann"
                }
              ]
            }
          },
          {
            "name": "refresh_token",
            "value": {
              "parts": [
                {
                  "token": "refreshToken"
                }
              ]
            }
          }
        ]
      }
    },
    "response": {
      "accessTokenPointer": "/access_token",
      "refreshTokenPointer": "/refresh_token"
    }
  },
  "http": {
    "origins": [
      "https://chatgpt.com"
    ],
    "headers": [
      {
        "name": "authorization",
        "value": {
          "parts": [
            {
              "literal": "Bearer "
            },
            {
              "accessToken": {}
            }
          ]
        }
      },
      {
        "name": "chatgpt-account-id",
        "value": {
          "parts": [
            {
              "jwtClaim": {
                "pointer": "/https:~1~1api.openai.com~1auth/chatgpt_account_id"
              }
            }
          ]
        }
      }
    ]
  },
  "expiry": {
    "relative": {
      "pointer": "/expires_in",
      "unit": "seconds"
    },
    "jwtExp": true,
    "skewSeconds": 60
  },
  "accountPointer": "/https:~1~1api.openai.com~1auth/chatgpt_account_id",
  "authFailure": [
    {
      "status": 401
    }
  ],
  "replay": [
    {
      "origin": "https://chatgpt.com",
      "method": "POST",
      "path": "/backend-api/codex/responses"
    }
  ]
}
