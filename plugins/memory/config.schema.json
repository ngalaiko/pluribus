{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "max_records": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "default": 10000
    },
    "max_content_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096,
      "default": 4096
    },
    "max_sources": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "default": 16
    },
    "max_result_bytes": {
      "type": "integer",
      "minimum": 256,
      "maximum": 16384,
      "default": 16384
    },
    "max_results": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 20
    }
  }
}
