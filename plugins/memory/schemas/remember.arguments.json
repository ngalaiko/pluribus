{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "kind": {
      "enum": [
        "fact",
        "preference",
        "belief",
        "goal",
        "procedure"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true
    },
    "basis": {
      "enum": [
        "explicit",
        "inferred"
      ]
    },
    "expiresAtMs": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "operationId",
    "scope",
    "kind",
    "content",
    "sources",
    "basis"
  ]
}
