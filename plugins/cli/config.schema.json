{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "conversation_id": {
      "type": "string",
      "minLength": 1,
      "default": "local"
    },
    "sender": {
      "type": "string",
      "minLength": 1,
      "default": "operator"
    },
    "poll_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300,
      "default": 20
    }
  }
}
