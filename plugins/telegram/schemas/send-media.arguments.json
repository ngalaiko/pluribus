{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "chat_id",
    "kind",
    "blob"
  ],
  "properties": {
    "chat_id": {
      "type": [
        "integer",
        "string"
      ]
    },
    "kind": {
      "enum": [
        "photo",
        "document",
        "audio",
        "voice",
        "video",
        "video_note",
        "animation",
        "sticker"
      ]
    },
    "blob": {
      "type": "object"
    },
    "file_name": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "spoiler": {
      "type": "boolean"
    },
    "message_thread_id": {
      "type": "integer"
    },
    "reply_to_message_id": {
      "type": "integer"
    }
  },
  "additionalProperties": false
}
