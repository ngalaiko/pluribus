{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "chat_id",
    "items"
  ],
  "properties": {
    "chat_id": {
      "type": [
        "integer",
        "string"
      ]
    },
    "items": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "blob"
        ],
        "properties": {
          "kind": {
            "enum": [
              "photo",
              "video",
              "audio",
              "document"
            ]
          },
          "blob": {
            "$ref": "#/$defs/blobRef"
          },
          "file_name": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "message_thread_id": {
      "type": "integer"
    },
    "reply_to_message_id": {
      "type": "integer"
    }
  },
  "$defs": {
    "blobRef": {
      "type": "object",
      "required": ["algorithm", "digest", "size"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 0 },
        "media_type": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "minLength": 1 },
        "media-type": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        { "required": ["media_type"] },
        { "required": ["mediaType"] },
        { "required": ["media-type"] }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
