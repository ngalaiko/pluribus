{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["token"],
  "properties": {
    "token": {
      "type": "string",
      "title": "Bot token",
      "minLength": 22,
      "pattern": "^[0-9]+:[A-Za-z0-9_-]{20,}$",
      "writeOnly": true
    }
  }
}
