{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "chat_id",
    "latitude",
    "longitude"
  ],
  "properties": {
    "chat_id": {
      "type": [
        "integer",
        "string"
      ]
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "title": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "message_thread_id": {
      "type": "integer"
    }
  },
  "additionalProperties": false
}
