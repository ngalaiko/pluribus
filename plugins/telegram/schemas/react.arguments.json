{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "chat_id",
    "message_id",
    "reaction"
  ],
  "properties": {
    "chat_id": {
      "type": [
        "integer",
        "string"
      ]
    },
    "message_id": {
      "type": "integer"
    },
    "reaction": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
