{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pluribus:credential/static-http@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["http"],
  "properties": {
    "http": { "$ref": "#/$defs/http" }
  },
  "$defs": {
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parts"],
      "properties": {
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["literal"],
                "properties": { "literal": { "type": "string" } }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["input"],
                "properties": { "input": { "type": "string", "minLength": 1 } }
              }
            ]
          }
        }
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/template" }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origins"],
      "properties": {
        "origins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        },
        "headers": { "type": "array", "items": { "$ref": "#/$defs/header" } },
        "pathPrefix": { "$ref": "#/$defs/template" }
      },
      "anyOf": [
        { "required": ["headers"] },
        { "required": ["pathPrefix"] }
      ]
    }
  }
}
