{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pluribus:credential/oauth-device@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "start",
    "prompt",
    "poll",
    "token",
    "refresh",
    "http",
    "expiry",
    "authFailure",
    "replay"
  ],
  "properties": {
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "start": {
      "$ref": "#/$defs/request"
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verificationUri",
        "userCode",
        "intervalSeconds",
        "expiresInSeconds"
      ],
      "properties": {
        "verificationUri": {
          "$ref": "#/$defs/template"
        },
        "userCode": {
          "$ref": "#/$defs/template"
        },
        "intervalSeconds": {
          "$ref": "#/$defs/number-source"
        },
        "expiresInSeconds": {
          "$ref": "#/$defs/number-source"
        }
      }
    },
    "poll": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request"
      ],
      "properties": {
        "request": {
          "$ref": "#/$defs/request"
        },
        "pendingStatuses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          }
        },
        "errorPointer": {
          "type": "string"
        },
        "pendingErrors": {
          "$ref": "#/$defs/error-codes"
        },
        "slowDownErrors": {
          "$ref": "#/$defs/error-codes"
        },
        "deniedErrors": {
          "$ref": "#/$defs/error-codes"
        },
        "expiredErrors": {
          "$ref": "#/$defs/error-codes"
        }
      }
    },
    "exchange": {
      "$ref": "#/$defs/request"
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accessTokenPointer",
        "refreshTokenPointer"
      ],
      "properties": {
        "accessTokenPointer": {
          "type": "string"
        },
        "refreshTokenPointer": {
          "type": "string"
        },
        "expiresInPointer": {
          "type": "string"
        }
      }
    },
    "refresh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request": {
          "$ref": "#/$defs/request"
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accessTokenPointer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/"
            },
            "refreshTokenPointer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/"
            }
          },
          "required": [
            "accessTokenPointer"
          ]
        },
        "failure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "retryableStatuses",
            "backoffSeconds"
          ],
          "properties": {
            "retryableStatuses": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 4,
              "items": {
                "enum": [
                  429,
                  502,
                  503,
                  504
                ]
              }
            },
            "backoffSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          }
        }
      },
      "required": [
        "request",
        "response"
      ]
    },
    "http": {
      "$ref": "#/$defs/http"
    },
    "expiry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relative": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pointer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/"
            },
            "unit": {
              "enum": [
                "seconds",
                "milliseconds"
              ]
            }
          },
          "required": [
            "pointer",
            "unit"
          ]
        },
        "absolute": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pointer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^/"
            },
            "unit": {
              "enum": [
                "seconds",
                "milliseconds"
              ]
            }
          },
          "required": [
            "pointer",
            "unit"
          ]
        },
        "jwtExp": {
          "type": "boolean"
        },
        "refreshIntervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "skewSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        }
      },
      "required": [
        "skewSeconds"
      ]
    },
    "accountPointer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "authFailure": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              401,
              403
            ]
          },
          "errorPointer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^/"
          },
          "codes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        "required": [
          "status"
        ]
      }
    },
    "replay": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "origin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "method": {
            "enum": [
              "GET",
              "HEAD",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "OPTIONS"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/",
            "maxLength": 4096
          }
        },
        "required": [
          "origin",
          "method",
          "path"
        ]
      }
    }
  },
  "$defs": {
    "error-codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "response-ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "pointer"
      ],
      "properties": {
        "step": {
          "enum": [
            "start",
            "poll"
          ]
        },
        "pointer": {
          "type": "string"
        }
      }
    },
    "part": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "literal"
          ],
          "properties": {
            "literal": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input"
          ],
          "properties": {
            "input": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "response"
          ],
          "properties": {
            "response": {
              "$ref": "#/$defs/response-ref"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accessToken"
          ],
          "properties": {
            "accessToken": {
              "type": "object",
              "maxProperties": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "jwtClaim"
          ],
          "properties": {
            "jwtClaim": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pointer"
              ],
              "properties": {
                "pointer": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "token": {
              "enum": [
                "accessToken",
                "refreshToken"
              ]
            }
          },
          "required": [
            "token"
          ]
        }
      ]
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parts"
      ],
      "properties": {
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/part"
          },
          "maxItems": 64
        }
      }
    },
    "number-source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "step": {
          "enum": [
            "start",
            "poll"
          ]
        },
        "pointer": {
          "type": "string"
        },
        "default": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      },
      "required": [
        "default"
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/$defs/template"
        }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "fields"
      ],
      "properties": {
        "encoding": {
          "enum": [
            "json",
            "form"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          },
          "maxItems": 64
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "url",
        "body"
      ],
      "properties": {
        "method": {
          "enum": [
            "POST"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "body": {
          "$ref": "#/$defs/body"
        },
        "headers": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "name",
              "value"
            ]
          }
        }
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/$defs/template"
        }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origins",
        "headers"
      ],
      "properties": {
        "origins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "headers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/header"
          }
        },
        "pathPrefix": {
          "$ref": "#/$defs/template"
        }
      }
    }
  }
}
