package pluribus:plugin@1.0.0;

/// Event-driven lifecycle. Source components additionally export ingress.
/// sources, capability providers, model providers, event sinks, context
/// providers, and cognition. A plugin's role is described by the request
/// schemas it declares in its manifest, not by a distinct interface.
interface lifecycle {
  use types.{error, event, json, mutation, principal, proposal};

  /// Host-assigned facts about the current call. A plugin cannot forge or
  /// widen them.
  record context {
    instance-id: string,
    agent: principal,

    /// Sequence this instance's state namespace is current as of. Zero
    /// means the namespace is empty and must be rebuilt.
    state-checkpoint: u64,

    /// Recursion depth of the activity that produced this delivery.
    depth: u32,

    deadline-at-ms: option<s64>,
  }

  /// The transactional result of one call. The host commits `events`,
  /// `mutations`, and the advance to `checkpoint` atomically, or commits
  /// none of them. A crash therefore cannot leave a projection ahead of
  /// its delivery cursor or a result recorded twice.
  record outcome {
    events: list<proposal>,
    mutations: list<mutation>,

    /// Highest delivered sequence fully reflected in `events` and
    /// `mutations`. MUST fall within the delivered batch. `handle` MUST
    /// set it or the batch is delivered again. Absent in `init` and
    /// `stop`, which deliver no events.
    checkpoint: option<u64>,
  }

  /// Called once per instance lifetime, before any delivery, with the
  /// configuration validated against the manifest schema. Secret values
  /// appear only as opaque credential handles.
  ///
  /// A configuration change restarts the instance and calls `init` again.
  /// A state schema change clears the namespace first, so `init` and the
  /// deliveries that follow must tolerate an empty projection.
  init: func(context: context, config: json) -> result<outcome, error>;

  /// Delivers events in ascending sequence order, at least once. The
  /// plugin MUST tolerate events it has already applied and MUST NOT
  /// claim a checkpoint it did not receive.
  ///
  /// The host selects the batch from this instance's declared
  /// subscriptions. A cognition plugin subscribes to the whole stream and
  /// filters internally; other plugins subscribe to the request types
  /// they handle.
  ///
  /// The plugin holds no live work across a return. To wait on another
  /// plugin, propose a request event and resume from its result event.
  handle: func(context: context, events: list<event>) -> result<outcome, error>;

  /// Final call before the instance is torn down. Handles are already
  /// closed; further deliveries will not arrive.
  stop: func(context: context, deadline-at-ms: s64) -> result<outcome, error>;
}

/// The standard world. Grants are enforced per call, so an import present
/// here may still return `permission-denied`. A plugin MAY declare a
/// narrower custom world for defense in depth; its manifest records which
/// world the component encodes.
world plugin {
  import events;
  import state;
  import blobs;
  import reader;
  import writer;
  import http;
  import socket;
  import credentials;

  export lifecycle;
}

/// Optional ingress callback. Transport input is transient; only the returned
/// observations and state changes are committed. Empty long-poll responses do
/// not produce log entries. Init restores the
/// subscription; the source protocol must tolerate redelivery after restart.
interface ingress {
  use types.{json, error, ingress-outcome};
  receive: func(input: json) -> result<ingress-outcome, error>;
}

world source {
  include plugin;
  export ingress;
}
