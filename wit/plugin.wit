package pluribus:plugin@2.0.0;

/// Shared lifecycle for all component roles, described by their manifests.
interface lifecycle {
  use types.{error, event, json, mutation, principal, proposal, context};

  /// The transactional result of one call. The host commits `events`,
  /// `mutations`, and the advance to `checkpoint` atomically, or commits
  /// none of them. A crash therefore cannot leave a projection ahead of
  /// its delivery cursor or a result recorded twice.
  record outcome {
    events: list<proposal>,
    mutations: list<mutation>,

    /// Highest delivered sequence fully reflected in `events` and
    /// `mutations`. MUST fall within the delivered batch. `handle` MUST
    /// set it or the batch is delivered again. Absent in startup output and
    /// `stop`, which deliver no events.
    checkpoint: option<u64>,
  }

  /// Loads validated configuration, then calls runtime.ready with startup output.
  /// The host commits startup output and replays history before releasing ready.
  /// Continues until shutdown; configuration changes restart the instance.
  run: async func(context: context, config: json) -> result<_, error>;

  /// Delivers events in ascending sequence order, at least once. The
  /// plugin MUST tolerate events it has already applied and MUST NOT
  /// claim a checkpoint it did not receive.
  ///
  /// The host selects the batch from this instance's declared
  /// subscriptions. A cognition plugin subscribes to the whole stream and
  /// filters internally; other plugins subscribe to the request types
  /// they handle.
  ///
  /// The plugin holds no live work across a return. To wait on another
  /// plugin, propose a request event and resume from its result event.
  handle: async func(context: context, events: list<event>) -> result<outcome, error>;

  /// Final call before the instance is torn down. Handles are already
  /// closed; further deliveries will not arrive.
  stop: func(context: context, deadline-at-ms: s64) -> result<outcome, error>;
}

/// The standard world. Grants are enforced per call, so an import present
/// here may still return `permission-denied`. A plugin MAY declare a
/// narrower custom world for defense in depth; its manifest records which
/// world the component encodes.
world plugin {
  import wasi:clocks/system-clock@0.3.0;
  import wasi:clocks/monotonic-clock@0.3.0;
  import wasi:random/random@0.3.0;
  import runtime;
  import events;
  import state;
  import blobs;
  import wasi:http/types@0.3.0;
  import wasi:http/client@0.3.0;
  import socket;
  import credentials;

  export lifecycle;
}

