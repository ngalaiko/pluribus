package pluribus:plugin@2.0.0;

/// The coordination contract. Every decision, request, and result is an
/// event. Plugins do not call each other; they answer request events and
/// propose result events.
interface events {
  use types.{error, event, proposal};

  /// Filter over the current agent stream. An empty or absent field does
  /// not constrain.
  record filter {
    after-sequence: option<u64>,
    event-types: list<string>,
    correlation-id: option<string>,
    activity-id: option<string>,
    recorded-from-ms: option<s64>,
    recorded-to-ms: option<s64>,
  }

  record page {
    events: list<event>,
    /// Sequence to resume from. Absent when the page reached the end of
    /// the stream at read time. Presence is not proof that more events
    /// exist.
    next-sequence: option<u64>,
  }

  /// Appends outside the delivery transaction, returning the assigned
  /// sequence. The event commits before the handling returns and is
  /// therefore visible even if the handling later fails.
  ///
  /// Use it only for non-terminal progress that must be observable while
  /// work continues: model deltas and capability output. Terminal results
  /// belong in `lifecycle.outcome`, which commits atomically with state
  /// and delivery progress.
  ///
  /// `idempotency-key` is required. A redelivered attempt MUST reuse the
  /// same keys so that repetition deduplicates instead of duplicating.
  append: func(proposal: proposal) -> result<u64, error>;

  get: func(event-id: string) -> result<event, error>;

  /// Returns matching events in ascending sequence order. Visibility and
  /// grants may withhold events or their payloads.
  query: func(filter: filter, limit: u32) -> result<page, error>;
}

/// Durable storage namespaced by plugin instance. Source cursors and pending
/// work persist here; event projections can be rebuilt from their event log.
/// Writes travel through lifecycle outcomes or runtime.commit so that state,
/// emitted events, and delivery progress commit atomically.
interface state {
  use types.{error, state-entry};

  record page {
    entries: list<state-entry>,
    next-key: option<string>,
  }

  get: func(key: string) -> result<option<list<u8>>, error>;

  /// Lexicographic scan over UTF-8 keys from one consistent revision.
  scan: func(prefix: string, after-key: option<string>, limit: u32)
    -> result<page, error>;
}

/// Content-addressed storage for payloads too large to carry in an event.
interface blobs {
  use types.{blob-ref, chunk, error};

  /// Whole-blob write for content that fits one message.
  put: func(media-type: string, bytes: list<u8>) -> result<blob-ref, error>;

  /// Chunked write for larger content. The handle is valid until the
  /// current delivery ends.
  open-write: func(media-type: string, expected-size: option<u64>)
    -> result<string, error>;

  /// Accepts only the next contiguous offset, or a byte-identical repeat
  /// of the previous chunk. Returns the next expected offset.
  write: func(handle: string, offset: u64, bytes: list<u8>)
    -> result<u64, error>;

  /// Verifies size, computes the digest, and commits. Equal bytes
  /// deduplicate.
  finish: func(handle: string) -> result<blob-ref, error>;

  /// Returns at most `max-bytes`. The plugin MUST verify that the
  /// cumulative length equals `blob-ref.size`.
  read: func(blob: blob-ref, offset: u64, max-bytes: u32)
    -> result<chunk, error>;
}

/// Read half of a byte channel. The interface that opens a channel
/// authorizes it; this one only moves bytes.
///
/// Dropping the reader ends the transfer.
interface reader {
  use types.{chunk, error};

  resource reader {
    /// Opens a native byte stream. Completion carries transport errors.
    /// Available on readiness-driven socket readers; keep the reader alive
    /// until the stream is consumed or dropped. Open at most once.
    read-via-stream: async func() -> result<tuple<stream<u8>, future<result<_, error>>>, error>;

    /// Bounded read during a request delivery. Timeout returns an empty chunk.
    receive: func(max-bytes: u32, timeout-ms: u32) -> result<chunk, error>;
  }
}

/// Write half of a byte channel.
///
/// Dropping the writer half-closes the channel: the peer reads EOF while
/// the read half stays open. An endpoint MAY treat that as cancellation,
/// as the shell executor does, so hold the writer until the exchange is
/// done. There is no host-side write buffer; each `send` is one write, so
/// the plugin decides framing by choosing when to call it.
interface writer {
  use types.{error};

  resource writer {
    /// Writes the whole buffer or fails.
    send: func(bytes: list<u8>) -> result<_, error>;
  }
}

/// Byte channel to the one Unix socket endpoint granted to this instance.
///
/// The host owns transport, peer-credential verification, and byte and
/// time budgets. The plugin owns framing and protocol. No credential is
/// injected; an endpoint grant conveys whatever authority that endpoint
/// exposes.
interface socket {
  use reader.{reader};
  use writer.{writer};
  use types.{error};

  /// Connects the granted endpoint, returning both halves. They share one
  /// transport and one byte budget; it closes when both are dropped.
  /// Denied outside a request delivery.
  connect: func() -> result<tuple<reader, writer>, error>;

  /// Opens a readiness-driven connection. The plugin owns requests and reconnects.
  listen: func() -> result<tuple<reader, writer>, error>;

}

/// Explicitly granted access to a plugin's own credential records.
interface credentials {
  use wasi:http/types@0.3.0.{request};
  use types.{error};
  /// Attaches a granted credential to one request. Secret bytes remain in the host.
  authorize-http: func(request: borrow<request>, handle: string) -> result<_, error>;
  resolve-export: func(binding: string) -> result<string, error>;
  get: func(handle: string) -> result<option<list<u8>>, error>;
  compare-and-swap: func(handle: string, expected: option<list<u8>>, value: list<u8>) -> result<bool, error>;
}

/// Cooperative source execution. One Wasm task owns the instance state.
interface runtime {
  use types.{error, event, proposal, mutation};

  variant wake {
    events(list<event>),
    stop(s64),
  }

  /// Submits startup output once, then suspends until activation after replay.
  /// Startup output cannot advance the delivery checkpoint.
  ready: async func(events: list<proposal>, mutations: list<mutation>) -> result<_, error>;
  /// Suspends until an internal delivery or shutdown is available.
  next: async func() -> result<wake, error>;
  /// Atomically commits output and optional internal delivery progress.
  /// External observations require explicit idempotency keys.
  commit: func(events: list<proposal>, mutations: list<mutation>, checkpoint: option<u64>) -> result<_, error>;
  reject: func(error: error) -> result<_, error>;
}
